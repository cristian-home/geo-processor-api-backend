FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install uv
RUN pip install uv

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies
RUN uv sync --extra tests

# Copy application code and tests
COPY app/ ./app/
COPY tests/ ./tests/
COPY main.py pytest.ini ./

# Run tests
CMD ["uv", "run", "pytest"]
